From 392194f54625d949e41d1c821c02f6b886a3a43f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 19:08:50 +0000
Subject: [PATCH 2/3] DomeSurvey: roundness calibrated on in-game views, shared
 trough test

The roundness score now weighs what read as rounded in screenshots of
21 sites of world 12345: a top that stays gentle for 32 blocks all
round or steepens away from the summit (half), a domed top under the
gullies and teeth (a quarter) and faces smooth at the block scale (a
quarter); ROUND at 0.55 and more, POINTED at 0.25 and less. The upper
ground's uneroded slope and the share of it under 0.6 (where the
gullies are weakened) are reported, and the summit, flank and census
modes share one test for a range shape lowered by a valley trough.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01P4U2ge3L4SazHBdDSoJUZ9
---
 .../com/terrahaul/devtools/DomeSurvey.java    | 25 +++++++++++--------
 1 file changed, 15 insertions(+), 10 deletions(-)

diff --git a/terrahaul/src/devtools/java/com/terrahaul/devtools/DomeSurvey.java b/terrahaul/src/devtools/java/com/terrahaul/devtools/DomeSurvey.java
index e0cfd2a..71a0be8 100644
--- a/terrahaul/src/devtools/java/com/terrahaul/devtools/DomeSurvey.java
+++ b/terrahaul/src/devtools/java/com/terrahaul/devtools/DomeSurvey.java
@@ -74,10 +74,14 @@ import java.util.stream.IntStream;
  *       crest weight over 0.5; over the upper ground: the share without gullies, the median slope
  *       of the uneroded surface and the share where it is under 0.6 (where the gullies are
  *       weakened).</li>
- *   <li><b>roundness</b> (0..1): the mean of {@code clamp((1.1 - cone32_128) / 0.7)} (the summit
- *       is convex over 32-128 blocks), {@code clamp((1.0 - ucone) / 0.7)} (the top under the
- *       teeth is a dome) and {@code clamp((fineSmooth - 0.2) / 0.6)} (smooth faces). ROUND at 0.5
- *       or more, POINTED at 0.2 or less.</li>
+ *   <li><b>roundness</b> (0..1): half the larger of {@code clamp((0.9 - drop32/32) / 0.5)} (the
+ *       top is gentle for 32 blocks all round: under 22 degrees on average counts fully, over 42
+ *       not at all) and {@code clamp((1.1 - cone32_128) / 0.6)} (the summit steepens away from
+ *       the top over 32-128 blocks: convex, a dome), a quarter {@code clamp((1.0 - ucone) / 0.7)}
+ *       (the top under the gullies and teeth is a dome) and a quarter {@code clamp((fineSmooth -
+ *       0.2) / 0.6)} (smooth faces). ROUND at 0.55 or more, POINTED at 0.25 or less. The weights
+ *       and limits were set against in-game views of sites of world 12345. A steep convex summit
+ *       seen from right below can still read as a point (the profile foreshortens).</li>
  * </ul>
  * <b>Style</b> (at the summit): {@code massif} (colossal massif term over 0.1), {@code wall} (mountain
  * wall), {@code ancient}, {@code horn} (alpine, the horns above the crest network at the summit) or
@@ -130,8 +134,8 @@ import java.util.stream.IntStream;
  */
 public final class DomeSurvey {
     /** Roundness at and above which a site counts as ROUND, and at and below which as POINTED. */
-    private static final double ROUND = 0.5;
-    private static final double POINTED = 0.2;
+    private static final double ROUND = 0.55;
+    private static final double POINTED = 0.25;
     /** Grid spacing: the corners the game interpolates between. */
     private static final int G = 4;
     /** Radius of the measured disc around a summit, and the margin the fits and crest checks need (blocks). */
@@ -971,12 +975,13 @@ public final class DomeSurvey {
         site.style = style;
         site.flags = flags.toString();
         // ---- roundness -----------------------------------------------------------------------
-        // (the dome is a broad shape: the summit's profile over 32-128 blocks, the uneroded
-        // summit under the gullies and teeth over 16-64, and faces smooth at the block scale)
-        double a = clamp01((1.1 - site.cone2) / 0.7);
+        // (calibrated on in-game views: a top that is gentle for 32 blocks all round, or that
+        // steepens away from the summit, reads as a dome whatever stands on it; so does a domed
+        // top under the gullies and teeth, and smooth faces read as terraced curtains)
+        double a = Math.max(clamp01((0.9 - site.drop[2] / 32.0) / 0.5), clamp01((1.1 - site.cone2) / 0.6));
         double b = clamp01((1.0 - site.ucone) / 0.7);
         double c = clamp01((site.fineSmooth - 0.2) / 0.6);
-        site.roundness = (a + b + c) / 3.0;
+        site.roundness = 0.5 * a + 0.25 * b + 0.25 * c;
         camera(model, site, g, water);
         return site;
     }
